# PlateLens — Configuração de Ambiente (opcional: pode configurar a API pela WebUI ao iniciar)
# Nunca commite seu .env real com chaves de API!

# Provedor de visão: gemini | ollama | disabled
VISION_PROVIDER=gemini

# Google AI Studio (opcional no .env — se vazio, o app solicita ao abrir a WebUI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Ollama opcional na LAN (se tiver GPU/RAM em outro servidor local)
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5vl:3b

# Armazenamento e servidor
PLATELENS_DATA_DIR=./data
MAX_IMAGE_SIDE_PX=1280
PORT=8502
